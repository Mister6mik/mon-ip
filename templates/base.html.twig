{% set isDarkMode = app.request.cookies.get('dark_mode') %}
<!DOCTYPE html>
<html class="bg-white dark:bg-emerald-950">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}{{ 'title'|trans }}{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		{% block stylesheets %}
			<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
		{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body class="bg-white dark:bg-emerald-950 min-h-screen">
		<header class="bg-white dark:bg-emerald-950" data-controller="toggle">
			<nav class="mx-auto flex max-w-7xl items-center lg:justify-between p-6 lg:px-8" aria-label="Global">
				<div class="flex lg:flex-1">
					<a href="{{ path('app_default') }}" class="-m-1.5 p-1.5">
						<span class="sr-only">{{ 'name'|trans }}</span> 
						<twig:ux:icon class="h-8 w-auto text-emerald-950 dark:text-emerald-300" name="mingcute:target-line" />
					</a>
				</div>
				<div class="hidden lg:flex lg:gap-x-12">
					{# <div class="relative" 
                        data-controller="dropdown"
                        data-action="click@window->dropdown#hide touchstart@window->dropdown#hide keydown.up->dropdown#previousItem keydown.down->dropdown#nextItem keydown.esc->dropdown#hide">
						<button data-action="dropdown#toggle:stop" 
                            type="button" 
                            class="flex items-center gap-x-1 text-sm font-semibold leading-6 text-emerald-900 dark:text-emerald-300" aria-expanded="false">
							Product
							<svg class="h-5 w-5 flex-none text-gray-400" viewbox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
								<path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
							</svg>
						</button>

						<!--
						          'Product' flyout menu, show/hide based on flyout menu state.
						
						          Entering: "transition ease-out duration-200"
						            From: "opacity-0 translate-y-1"
						            To: "opacity-100 translate-y-0"
						          Leaving: "transition ease-in duration-150"
						            From: "opacity-100 translate-y-0"
						            To: "opacity-0 translate-y-1"
						        -->
						<div data-dropdown-target="menu" class="absolute -left-8 top-full z-10 mt-3 w-screen max-w-md overflow-hidden rounded-3xl backdrop-blur-sm bg-emerald-700/20 shadow-lg ring-1 ring-gray-900/5">
							<div class="p-4">
								<div class="group relative flex items-center gap-x-6 rounded-lg p-4 text-sm leading-6 hover:bg-gray-50/30">
									<div class="flex h-11 w-11 flex-none items-center justify-center rounded-lg bg-gray-50/30 group-hover:bg-white">
										<svg class="h-6 w-6 text-emerald-600 dark:text-emerald-100 group-hover:text-emerald-600" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
											<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z"/>
											<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z"/>
										</svg>
									</div>
									<div class="flex-auto">
										<a href="#" data-dropdown-target="menuItem" class="block font-semibold text-emerald-900 dark:text-emerald-300">
											Analytics
											<span class="absolute inset-0"></span>
										</a>
										<p class="mt-1 text-gray-600 dark:text-gray-100">Get a better understanding of your traffic</p>
									</div>
								</div>
								<div class="group relative flex items-center gap-x-6 rounded-lg p-4 text-sm leading-6 hover:bg-gray-50/30">
									<div class="flex h-11 w-11 flex-none items-center justify-center rounded-lg bg-gray-50/30 group-hover:bg-white">
										<svg class="h-6 w-6 text-emerald-600 dark:text-emerald-100 group-hover:text-emerald-600" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
											<path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672 13.684 16.6m0 0-2.51 2.225.569-9.47 5.227 7.917-3.286-.672ZM12 2.25V4.5m5.834.166-1.591 1.591M20.25 10.5H18M7.757 14.743l-1.59 1.59M6 10.5H3.75m4.007-4.243-1.59-1.59"/>
										</svg>
									</div>
									<div class="flex-auto">
										<a href="#" data-dropdown-target="menuItem" class="block font-semibold text-emerald-900 dark:text-emerald-300">
											Engagement
											<span class="absolute inset-0"></span>
										</a>
										<p class="mt-1 text-gray-600 dark:text-gray-100">Speak directly to your customers</p>
									</div>
								</div>
								<div class="group relative flex items-center gap-x-6 rounded-lg p-4 text-sm leading-6 hover:bg-gray-50/30">
									<div class="flex h-11 w-11 flex-none items-center justify-center rounded-lg bg-gray-50/30 group-hover:bg-white">
										<svg class="h-6 w-6 text-emerald-600 dark:text-emerald-100 group-hover:text-emerald-600" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
											<path stroke-linecap="round" stroke-linejoin="round" d="M7.864 4.243A7.5 7.5 0 0 1 19.5 10.5c0 2.92-.556 5.709-1.568 8.268M5.742 6.364A7.465 7.465 0 0 0 4.5 10.5a7.464 7.464 0 0 1-1.15 3.993m1.989 3.559A11.209 11.209 0 0 0 8.25 10.5a3.75 3.75 0 1 1 7.5 0c0 .527-.021 1.049-.064 1.565M12 10.5a14.94 14.94 0 0 1-3.6 9.75m6.633-4.596a18.666 18.666 0 0 1-2.485 5.33"/>
										</svg>
									</div>
									<div class="flex-auto">
										<a href="#" data-dropdown-target="menuItem" class="block font-semibold text-emerald-900 dark:text-emerald-300">
											Security
											<span class="absolute inset-0"></span>
										</a>
										<p class="mt-1 text-gray-600 dark:text-gray-100">Your customers’ data will be safe and secure</p>
									</div>
								</div>
								<div class="group relative flex items-center gap-x-6 rounded-lg p-4 text-sm leading-6 hover:bg-gray-50/30">
									<div class="flex h-11 w-11 flex-none items-center justify-center rounded-lg bg-gray-50/30 group-hover:bg-white">
										<svg class="h-6 w-6 text-emerald-600 dark:text-emerald-100 group-hover:text-emerald-600" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
											<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 16.875h3.375m0 0h3.375m-3.375 0V13.5m0 3.375v3.375M6 10.5h2.25a2.25 2.25 0 0 0 2.25-2.25V6a2.25 2.25 0 0 0-2.25-2.25H6A2.25 2.25 0 0 0 3.75 6v2.25A2.25 2.25 0 0 0 6 10.5Zm0 9.75h2.25A2.25 2.25 0 0 0 10.5 18v-2.25a2.25 2.25 0 0 0-2.25-2.25H6a2.25 2.25 0 0 0-2.25 2.25V18A2.25 2.25 0 0 0 6 20.25Zm9.75-9.75H18a2.25 2.25 0 0 0 2.25-2.25V6A2.25 2.25 0 0 0 18 3.75h-2.25A2.25 2.25 0 0 0 13.5 6v2.25a2.25 2.25 0 0 0 2.25 2.25Z"/>
										</svg>
									</div>
									<div class="flex-auto">
										<a href="#" data-dropdown-target="menuItem"class="block font-semibold text-emerald-900 dark:text-emerald-300">
											Integrations
											<span class="absolute inset-0"></span>
										</a>
										<p class="mt-1 text-gray-600 dark:text-gray-100">Connect with third-party tools</p>
									</div>
								</div>
								<div class="group relative flex items-center gap-x-6 rounded-lg p-4 text-sm leading-6 hover:bg-gray-50/30">
									<div class="flex h-11 w-11 flex-none items-center justify-center rounded-lg bg-gray-50/30 group-hover:bg-white">
										<svg class="h-6 w-6 text-emerald-600 dark:text-emerald-100 group-hover:text-emerald-600" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
											<path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/>
										</svg>
									</div>
									<div class="flex-auto">
										<a href="#" data-dropdown-target="menuItem" class="block font-semibold text-emerald-900 dark:text-emerald-300">
											Automations
											<span class="absolute inset-0"></span>
										</a>
										<p class="mt-1 text-gray-600 dark:text-gray-100">Build strategic funnels that will convert</p>
									</div>
								</div>
							</div>
							<div class="grid grid-cols-2 divide-x divide-gray-900/5 backdrop-blur-sm bg-gray-50/30">
								<a href="#" class="flex items-center justify-center gap-x-2.5 p-3 text-sm font-semibold leading-6 text-emerald-900 dark:text-emerald-300 hover:bg-gray-100">
									<svg class="h-5 w-5 flex-none text-gray-400" viewbox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
										<path fill-rule="evenodd" d="M2 10a8 8 0 1 1 16 0 8 8 0 0 1-16 0Zm6.39-2.908a.75.75 0 0 1 .766.027l3.5 2.25a.75.75 0 0 1 0 1.262l-3.5 2.25A.75.75 0 0 1 8 12.25v-4.5a.75.75 0 0 1 .39-.658Z" clip-rule="evenodd"/>
									</svg>
									Watch demo
								</a>
								<a href="#" class="flex items-center justify-center gap-x-2.5 p-3 text-sm font-semibold leading-6 text-emerald-900 dark:text-emerald-300 hover:bg-gray-100">
									<svg class="h-5 w-5 flex-none text-gray-400" viewbox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
										<path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd"/>
									</svg>
									Contact sales
								</a>
							</div>
						</div>
					</div> #}

					<a href="{{ path('app_default') }}" class="text-sm font-semibold leading-6 text-emerald-900 dark:text-emerald-300">{{ 'menu.home.label'|trans }}</a>
					{# <a href="#" class="text-sm font-semibold leading-6 text-emerald-900 dark:text-emerald-300">Marketplace</a>
					<a href="#" class="text-sm font-semibold leading-6 text-emerald-900 dark:text-emerald-300">Company</a> #}
				</div>
                <div class="flex flex-1 justify-end">
                    <a  data-controller="dark-mode" 
                        data-action="dark-mode#toggleDarkMode" 
                        data-dark-mode-target="toggle" 
                        class="cursor-pointer text-emerald-900 hover:text-emerald-900 group flex-shrink-0 items-center flex gap-x-3 rounded-md p-2 text-sm leading-6 font-semibold transition-colors duration-300">
                        {% if isDarkMode %}
                            <twig:ux:icon name="heroicons:sun-solid" class="size-6 shrink-0 dark:block transition-transform duration-300 ease-in-out" />
                        {% else %}
                            <twig:ux:icon name="heroicons:moon-solid" class="size-6 shrink-0 dark:hidden transition-transform duration-300 ease-in-out" />
                        {% endif %}
                        <span class="sr-only">{{ 'dark'|trans }}</span>
                    </a>
                </div>
				<div class="flex lg:hidden justify-end">
					<button data-action="click->toggle#show touch->toggle#show" type="button" class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-emerald-700 dark:text-emerald-300">
						<span class="sr-only">{{ 'open'|trans }}</span>
                        <twig:ux:icon class="size-6" name="heroicons:bars-3" />
					</button>
				</div>
				{# <div class="hidden lg:flex lg:flex-1 lg:justify-end">
                    <a href="#" class="text-sm font-semibold leading-6 text-emerald-900 dark:text-emerald-300">Log in
						<span aria-hidden="true">&rarr;</span>
					</a> 
				</div> #}
			</nav>
			<!-- Mobile menu, show/hide based on menu open state. -->
			<div class="hidden" role="dialog" aria-modal="true" data-toggle-target="toggleable">
				<!-- Background backdrop, show/hide based on slide-over state. -->
				<div data-action="click->toggle#hide touch->toggle#hide" class="fixed inset-0 z-10 backdrop-blur-sm bg-emerald-700/20"></div>
				<div class="fixed inset-y-0 right-0 z-10 w-full overflow-y-auto bg-white dark:bg-emerald-950 px-6 py-6 sm:max-w-sm sm:ring-1 sm:ring-emerald-900/10">
					<div class="flex items-center justify-between">
						<a href="#" class="-m-1.5 p-1.5">
							<span class="sr-only">{{ 'name'|trans }}</span>
                            <twig:ux:icon class="h-8 w-auto text-emerald-950 dark:text-emerald-300" name="mingcute:target-line" />
						</a>
						<button autofocus data-action="click->toggle#hide touch->toggle#hide" type="button" class="-m-2.5 rounded-md p-2.5 text-emerald-700 dark:text-emerald-300">
							<span class="sr-only">{{ 'close'|trans }}</span>
                            <twig:ux:icon class="size-6" name="heroicons:x-mark" />
						</button>
					</div>
					<div class="mt-6 flow-root">
						<div class="-my-6 divide-y divide-gray-500/10">
							<div class="space-y-2 py-6">
								{# <div class="-mx-3"
                                    data-controller="dropdown"
                                    data-action="click@window->dropdown#hide touchstart@window->dropdown#hide keydown.up->dropdown#previousItem keydown.down->dropdown#nextItem keydown.esc->dropdown#hide">
									<button type="button" 
                                        data-action="dropdown#toggle:stop"
                                        class="flex w-full items-center justify-between rounded-lg py-2 pl-3 pr-3.5 text-base font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30" aria-controls="disclosure-1" aria-expanded="false">
										Product
                                        <twig:ux:icon class="size-5 flex-none" name="heroicons:chevron-down" />
									</button>
									<!-- 'Product' sub-menu, show/hide based on menu state. -->
									<div data-dropdown-target="menu" class="mt-2 space-y-2" id="disclosure-1">
										<a href="#" data-dropdown-target="menuItem" class="block rounded-lg py-2 pl-6 pr-3 text-sm font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30">Analytics</a>
										<a href="#" data-dropdown-target="menuItem" class="block rounded-lg py-2 pl-6 pr-3 text-sm font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30">Engagement</a>
										<a href="#" data-dropdown-target="menuItem" class="block rounded-lg py-2 pl-6 pr-3 text-sm font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30">Security</a>
										<a href="#" data-dropdown-target="menuItem" class="block rounded-lg py-2 pl-6 pr-3 text-sm font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30">Integrations</a>
										<a href="#" data-dropdown-target="menuItem" class="block rounded-lg py-2 pl-6 pr-3 text-sm font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30">Automations</a>
										<a href="#" data-dropdown-target="menuItem" class="block rounded-lg py-2 pl-6 pr-3 text-sm font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30">Watch demo</a>
										<a href="#" data-dropdown-target="menuItem" class="block rounded-lg py-2 pl-6 pr-3 text-sm font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30">Contact sales</a>
									</div>
								</div> #}
								<a href="{{ path('app_default') }}" class="-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30">{{ 'menu.home.label'|trans }}</a>
								{# <a href="#" class="-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30">Marketplace</a>
								<a href="#" class="-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30">Company</a> #}
							</div>
							{# <div class="py-6">
								<a href="#" class="-mx-3 block rounded-lg px-3 py-2.5 text-base font-semibold leading-7 text-emerald-900 dark:text-emerald-300 hover:bg-gray-50/30">Log in</a>
							</div> #}
						</div>
					</div>
				</div>
			</div>
		</header>
        <main class="p-2 lg:p-4">
		{% block body %}{% endblock %}
        </main>
	</body>
</html>
